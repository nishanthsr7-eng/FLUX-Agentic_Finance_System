# Keep the build context small. Dataset/ alone is ~30 GB and ai_engine ~2.4 GB;
# without this the daemon would try to ship both to the builder before the
# first instruction even runs.
Dataset/
ai_engine/
node_modules/
.git/
.github/
.venv/
venv/
.agent/
.claude/
.cursor/
.vscode/
.idea/

# Frontend — deployed separately to Cloudflare Pages, not served by the API.
js/
css/
pages/
assets/
index.html
package.json
package-lock.json

# Local-only state and caches
*.db
*.db-wal
*.db-shm
flux_chroma/
*.log
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Secrets never belong in an image layer — Spaces injects them as env vars.
.env
.env.*
!.env.example

# Archived training runs (not loaded at request time)
backend/prediction/models/baseline_backup/
backend/prediction/models/fred_model_gate1/

# Static build output — the API image never serves the frontend.
dist/
