# ─────────────────────────────────────────────────────────────────────────────
# FLUX — environment template
#
#   cp .env.example .env        (Windows:  copy .env.example .env)
#
# Every key below is OPTIONAL. FLUX degrades gracefully: a missing key disables
# only the feature that needs it, it never crashes the app. See docs/API_KEYS.md
# for where to obtain each one (all have a free tier).
# ─────────────────────────────────────────────────────────────────────────────

# ── Market data ──────────────────────────────────────────────────────────────
COINGECKO_API_KEY=              # crypto quotes  — coingecko.com/en/api
FINNHUB_API_KEY=                # equity quotes + earnings calendar — finnhub.io
ALPHA_VANTAGE_API_KEY=          # news sentiment feed — alphavantage.co
NEWSAPI_KEY=                    # headline ingestion — newsapi.org
FRED_API_KEY=                   # macro series (term spread, CPI) — fred.stlouisfed.org

# ── Reddit (retail-flow sentiment, Phase 13) ─────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=flux-market/0.1

# ── Alpaca (paper forward-testing ONLY — never live trading) ─────────────────
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true               # hard default: paper endpoint only

# ── Ollama (local LLM for insights, chat and the verifier layer) ─────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=aura

# ── Hosted LLM (deployment — replaces Ollama when LLM_API_KEY is set) ─────────
# No free host runs Ollama for you, so deployed builds point at any
# OpenAI-compatible /chat/completions endpoint. Leave LLM_API_KEY empty and the
# backend keeps using local Ollama exactly as before.
#   Groq        https://api.groq.com/openai/v1        openai/gpt-oss-120b
#   OpenRouter  https://openrouter.ai/api/v1          meta-llama/llama-3.3-70b-instruct:free
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai  gemini-2.0-flash
LLM_PROVIDER=                   # empty = auto (key present → openai); or "openai"/"ollama"
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# ── News sentiment backend (Layer 2c) ────────────────────────────────────────
# auto          = FinBERT/CryptoBERT when torch is installed, else the chat model
# transformers  = force the local models (needs torch, ~445 MB resident)
# llm           = force the chat model — what the 512 MB deploy target uses
SENTIMENT_BACKEND=auto

# ── Auth ─────────────────────────────────────────────────────────────────────
AUTH_REQUIRED=true              # false → unauthenticated requests act as demo user id=1
AUTH_SECRET=                    # empty → a random secret is generated and persisted

# ── MySQL (seeded dataset behind the user-facing pages) ──────────────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=flux
# Managed free tiers refuse plaintext connections — turn TLS on when the DB is
# not on localhost. TiDB Serverless also uses port 4000, not 3306.
#   MYSQL_HOST=gateway01.<region>.prod.aws.tidbcloud.com
#   MYSQL_PORT=4000
#   MYSQL_SSL=true
MYSQL_SSL=false
MYSQL_SSL_CA=                   # empty → certifi's bundle (right for every managed provider)

# ── Persistence paths ────────────────────────────────────────────────────────
# Empty → auto-resolve to the per-user app-data dir
# (%LOCALAPPDATA%/flux on Windows, ~/.local/share/flux elsewhere).
# Never point these at the project root: the dev static server serves it publicly.
DB_PATH=
CHROMA_PATH=

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ── Cache TTLs (seconds) ─────────────────────────────────────────────────────
CRYPTO_TTL=30
STOCKS_TTL=60
NEWS_TTL=300

# ── Ingestion scheduler ──────────────────────────────────────────────────────
INGESTION_ENABLED=true
INGESTION_INTERVAL_MIN=5
INSIGHT_MAX_ASSETS=6
SNAPSHOT_RETENTION_DAYS=7

# ── Dataset tooling (only needed by scripts/dl_*.py — see docs/DATASETS.md) ──
HUGGINGFACE_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KEY=
SEC_USER_AGENT=                 # SEC EDGAR requires "Your Name your@email.com"

# ── Feature-gate flags (ablation studies — see docs/AGENT_TRAINING.md) ───────
FLUX_CRYPTO_FEATURES=1
FLUX_EQUITY_FEATURES=1
FLUX_SENTIMENT_FEATURES=1
FLUX_FRED_RANKER=1
